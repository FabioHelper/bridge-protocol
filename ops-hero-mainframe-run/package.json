{
  "name": "ops-hero-mainframe-run",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "OPS HERO: Mainframe Run - an original 16-bit style side-scrolling browser platformer built with Phaser 4 + TypeScript + Vite.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,html,css}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,html,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "assets:inspect": "python3 tools/inspect_sources.py",
    "assets:placeholders": "python3 tools/make_placeholders.py",
    "assets:process": "python3 tools/process_assets.py",
    "assets:validate": "python3 tools/validate_assets.py",
    "assets:all": "npm run assets:process && npm run assets:validate",
    "verify": "npm run assets:schema && npm run typecheck && npm run lint && npm run test && npm run build",
    "gen:keys": "python3 tools/gen_asset_keys.py",
    "assets:schema": "python3 tools/validate_crop_config.py",
    "assets:selftest": "python3 tools/selftest_pipeline.py",
    "build:artifact": "vite build --config vite.artifact.config.ts && node tools/build_artifact.mjs",
    "assets:demo-fidelity": "python3 tools/demo_pixelgrid.py"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.12",
    "vitest": "^3.2.4"
  }
}
